# ONCHAIN X-RAY server-side configuration.
# Copy to .env.local (or set in your host's environment settings).
# Read on the server only. Never prefix any of these with NEXT_PUBLIC_.

HELIUS_API_KEY=
ENABLE_HELIUS=true

# Optional: shared rate limiting and caching across server instances.
# Leave blank to use the in-memory fallback (fine for one instance / local dev).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
